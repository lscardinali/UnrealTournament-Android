<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Setup downloads the game; the game itself plays online. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Controller rumble (SDL). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Handhelds and TV boxes: controller first, no touchscreen required. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400003" android:required="true" />

    <application
        android:allowNativeHeapPointerTagging="false"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:isGame="true"
        android:appCategory="game"
        android:supportsRtl="true"
        android:theme="@style/Theme.UnrealTournament">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- First-run setup: downloads and installs the game (SetupActivity.kt). -->
        <activity
            android:name=".SetupActivity"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="false" />

        <!-- The game: Android SDL3 hosting UT's own Linux arm64 binaries in-process (NativeGameActivity.kt). -->
        <activity
            android:name=".NativeGameActivity"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:launchMode="singleInstance"
            android:alwaysRetainTaskState="true"
            android:screenOrientation="sensorLandscape"
            android:preferMinimalPostProcessing="true"
            android:configChanges="layoutDirection|locale|fontScale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="false" />
    </application>

</manifest>
