# Native code calls into Java by name: keep SDL's Java side whole (SDLActivity, controller/audio managers).
-keep class org.libsdl.app.** { *; }

# JNI: libutloader exports Java_com_lscardinali_unrealtournament_* functions for these classes' native methods.
-keepclasseswithmembernames,includedescriptorclasses class * {
    native <methods>;
}
-keep class com.lscardinali.unrealtournament.NativeGameActivity { *; }

# Apache Commons Compress: optional codecs and OSGi/ASM bits we don't use.
-dontwarn org.apache.commons.compress.**
-dontwarn org.brotli.**
-dontwarn com.github.luben.zstd.**
-dontwarn org.objectweb.asm.**
-dontwarn org.osgi.**
