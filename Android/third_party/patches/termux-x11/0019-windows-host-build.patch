diff --git a/lorie/src/main/cpp/CMakeLists.txt b/lorie/src/main/cpp/CMakeLists.txt
index 314d6a0..c098034 100644
--- a/lorie/src/main/cpp/CMakeLists.txt
+++ b/lorie/src/main/cpp/CMakeLists.txt
@@ -18,12 +18,45 @@ include(CheckSymbolExists)
 include(CheckFunctionExists)
 include(CheckTypeSize)
 
+# UTAndroid: a Windows host has no bison, patch or gcc on Android Studio's PATH. Look in Git for Windows and MSYS2
+# (pacman -S bison); LORIE_HOST_TOOLS (environment) may name another directory first.
+if(CMAKE_HOST_WIN32)
+    list(APPEND CMAKE_PROGRAM_PATH "$ENV{LORIE_HOST_TOOLS}" "C:/msys64/usr/bin" "C:/Program Files/Git/usr/bin")
+endif()
 find_package(Python3 REQUIRED)
 find_package(BISON REQUIRED)
 
+if(CMAKE_HOST_WIN32)
+    # Not "bash -c": on Windows that can be WSL's bash.exe, and a failure here is silent.
+    find_program(LORIE_PATCH patch REQUIRED)
+    function(target_apply_patch patch_target d p)
+        execute_process(COMMAND "${LORIE_PATCH}" -p1 -d "${d}" -i "${p}" -R --dry-run
+                        RESULT_VARIABLE already OUTPUT_QUIET ERROR_QUIET)
+        if(NOT already EQUAL 0)
+            execute_process(COMMAND "${LORIE_PATCH}" -p1 -N -d "${d}" -i "${p}" -r - RESULT_VARIABLE failed)
+            if(NOT failed EQUAL 0)
+                message(FATAL_ERROR "Could not apply ${p} to ${d}")
+            endif()
+        endif()
+    endfunction()
+else()
 function(target_apply_patch patch_target d p)
     execute_process(COMMAND "bash" "-c" "patch -p1 -d ${d} -i ${p} -R --dry-run > /dev/null 2>&1 || patch -p1 -N -d ${d} -i ${p} -r -")
 endfunction()
+endif()
+
+# UTAndroid: creating symlinks needs Developer Mode or admin on Windows; copy instead (after any patching).
+function(lorie_link_or_copy src dst)
+    if(CMAKE_HOST_WIN32)
+        if(IS_DIRECTORY "${src}")
+            file(COPY "${src}/" DESTINATION "${dst}")
+        else()
+            configure_file("${src}" "${dst}" COPYONLY)
+        endif()
+    else()
+        execute_process(COMMAND ${CMAKE_COMMAND} -E create_symlink "${src}" "${dst}")
+    endif()
+endfunction()
 
 set(test_compile_options
         "-Wall"
